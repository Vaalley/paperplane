{
  "nodeModulesDir": "manual",
  "lock": true,
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "include": ["src", "*.ts", "*.js", "*.json", "*.md"]
  },
  "lint": {
    "include": ["src", "*.ts", "*.js"]
  },
  "tasks": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "fmt": "deno fmt",
    "lint": "deno lint"
  }
}
